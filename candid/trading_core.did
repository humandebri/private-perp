type AgentGeneration = record {
  account_id : blob;
  generation : nat64;
  approved_at : opt nat64;
  state : AgentState;
  agent_address : blob;
  expires_at : opt nat64;
};
// Agent世代の状態（`Implementation.md` 7章）。
type AgentState = variant {
  Failed;
  Active;
  Expiring;
  Approving;
  Requested;
  Revoked;
};
type AgentStatus = record {
  revocation_pending : bool;
  next : opt AgentGeneration;
  current : opt AgentGeneration;
  observed_at : nat64;
};
// 入力不正の理由コード。
type BadRequestCode = variant {
  NonceReused;
  UnsupportedMarket;
  TooLarge;
  NetworkMismatch;
  MalformedPayload;
  InvalidSignature;
  QuantityOutOfRange;
  ChallengeExpired;
  ExpiredIntent;
  AmountZero;
  PrecisionExceeded;
  OriginMismatch;
  ChallengeReused;
  DestinationNotAllowed;
  MissingField;
  PriceOutOfRange;
  UnsupportedAsset;
};
type CyclesStatus = record {
  warning : bool;
  observed_daily_burn : nat;
  balance : nat;
  refill_target : opt nat;
  exit_reserve : opt nat;
  configured_daily_floor : opt nat;
  estimated_days : opt nat64;
  new_risk_stopped : bool;
  observed_at : nat64;
};
// 解決済みの環境設定（既定値の適用と検証を通したもの）。
type EnvironmentView = record {
  // 閾値ECDSAのkey ID。
  ecdsa_key_id : text;
  // Hyperliquidの`/info` endpoint。
  info_url : text;
  network : Network;
  // Hyperliquidの`/exchange` endpoint。
  exchange_url : text;
};
// API全体のエラー。
type ErrorCode = variant {
  Internal : record { code : text };
  // 単一書込みフェンスの一時的な競合。受付ごとの再試行規則に従う。
  JournalWriterBusy;
  DuplicateIgnored : record { request_id : blob };
  SigningQueueFull;
  NotAllowed : record { code : NotAllowedCode };
  UpstreamUnavailable : record { venue : text };
  UnknownPending : record { action_id : blob };
  ReservationConflict;
  StaleAccountState : record { max_age_ms : nat64; observed_at : nat64 };
  IdempotencyConflict : record { request_id : blob };
  UpstreamRejected : record { code : text; retryable : bool };
  NotEligible : record { policy_version : nat64 };
  VenueRateLimited : record { retry_after_ms : opt nat64 };
  RiskLimitExceeded : record { limit : nat64 };
  SessionRevoked;
  BadRequest : record { code : BadRequestCode; detail : text };
  PolicyUnavailable;
  SessionExpired;
  InsufficientFunds : record { requested : nat64; available : nat64 };
  Unauthenticated : record { reason : text };
};
// 個人APIの要求封筒。
type HpkeRequest = record {
  // `network`・`canister`・`method`・`caller`・`request_id`・期限を束縛する。
  aad : blob;
  // 要求の単回使用ID（再送は拒否する）。
  request_id : blob;
  method : text;
  // ChaCha20-Poly1305の暗号文（`enc || ciphertext`）。
  ciphertext : blob;
  // サーバ公開鍵のID（現行世代の公開鍵そのもの）。
  key_id : blob;
  network : Network;
  // 応答を暗号化するブラウザ公開鍵。
  client_public_key : blob;
  // 呼び出し先のcanister principal（別canisterへの転用を拒否する）。
  canister : principal;
  expires_at : nat64;
};
// 個人APIの応答封筒。
type HpkeResponse = record {
  request_id : blob;
  // `client_public_key`宛の暗号文（`enc || ciphertext`）。
  ciphertext : blob;
  key_id : blob;
  observed_at : nat64;
};
// # HTTP Header.
// 
// Represents a HTTP header.
// 
// See [`HttpRequestArgs::headers`] and [`HttpRequestResult::headers`].
type HttpHeader = record {
  // Value of the header.
  value : text;
  // Name of the header.
  name : text;
};
// # HTTP Request Result
// 
// Result type of [`http_request`](https://docs.internetcomputer.org/references/management-canister/#http_request).
type HttpRequestResult = record {
  // The response status (e.g. 200, 404).
  status : nat;
  // The response’s body.
  body : blob;
  // List of HTTP response headers and their corresponding values.
  headers : vec HttpHeader;
};
type MarketStatus = record {
  eligible_for_new_risk : bool;
  market : text;
  reason_code : opt text;
  observed_at : opt nat64;
};
type MarketThreshold = record {
  max_spread_bps : nat32;
  min_day_notional_usdc : nat64;
  expected_index : nat32;
  market : text;
  min_each_side_depth_usdc : nat64;
};
// IC network。`docs/phase-0/environments.md` の環境分離の単位。
type Network = variant { Mainnet; Local; Testnet };
// 権限・状態に起因する拒否の理由コード。
type NotAllowedCode = variant {
  UpgradeContentMismatch;
  AssetNotAllowed;
  SessionIssuedByUnregisteredVault;
  UpgradeTooEarly;
  AccountNotOwned;
  OrderNotFound;
  CallerMismatch;
  OrderNotCancellable;
  UpgradeAlreadyExecuted;
  OperationNotAvailable;
  UpgradeNotScheduled;
};
// 送信結果が不明なleverage preflightを外部確認後に解決する。
type PreflightResolution = variant { Applied; Rejected };
type PrepareRecovery = record {
  account_id : blob;
  request_id : blob;
  user_id : blob;
  master_address : blob;
};
type RecoveryFenceToken = record {
  account_id : blob;
  request_id : blob;
  user_id : blob;
  epoch : nat64;
};
type Result = variant { Ok; Err : ErrorCode };
type Result_1 = variant { Ok : HpkeResponse; Err : ErrorCode };
type Result_10 = variant { Ok : RecoveryFenceToken; Err : ErrorCode };
type Result_11 = variant { Ok : bool; Err : ErrorCode };
type Result_12 = variant { Ok : record { nat64; bool }; Err : ErrorCode };
type Result_13 = variant { Ok : SweepOutcome; Err : ErrorCode };
type Result_2 = variant { Ok : AgentStatus; Err : ErrorCode };
type Result_3 = variant { Ok : CyclesStatus; Err : ErrorCode };
type Result_4 = variant { Ok : EnvironmentView; Err : ErrorCode };
type Result_5 = variant { Ok : blob; Err : ErrorCode };
type Result_6 = variant { Ok : opt principal; Err : ErrorCode };
type Result_7 = variant { Ok : record { bool; bool }; Err : ErrorCode };
type Result_8 = variant { Ok : MarketStatus; Err : ErrorCode };
type Result_9 = variant { Ok : record { nat64; nat64; bool }; Err : ErrorCode };
// 失効世代付きセッション。`trading_core` はvaultが発行したものだけを受け入れる。
type SessionHandle = record {
  session_id : blob;
  expires_at : nat64;
  vault_principal : principal;
  revocation_generation : nat64;
};
// `sweep`の結果（送信・取消・照合の件数）。失敗の内訳はログ・DBの状態で確認する。
type SweepOutcome = record {
  // 照合した口座の件数。
  reconciled : nat32;
  // 送信した注文の件数（受理・拒否・不明を含む）。
  dispatched : nat32;
  // 送信した取消の件数。
  cancels : nat32;
};
// # Transform Args.
// 
// ```text
// record {
// response : http_response;
// context : blob;
// }
// ```
// 
// See [`TransformContext`].
type TransformArgs = record {
  // Context for response transformation
  context : blob;
  // Raw response from remote service, to be transformed
  response : HttpRequestResult;
};
service : () -> {
  abort_recovery : (RecoveryFenceToken) -> (Result);
  begin_recovery_migration : () -> (Result);
  // 注文の取消を要求する（**封筒必須**。署名・送信はパイプラインが行う）。
  // 
  // 認証は封筒の`aad`と本文のセッションで行う（`api-contract.md` 6節）。
  cancel_order : (HpkeRequest) -> (Result_1);
  commit_recovery : (RecoveryFenceToken) -> (Result);
  configure_cycles : (nat, nat) -> (Result);
  configure_market_threshold : (MarketThreshold) -> (Result);
  finish_recovery : (RecoveryFenceToken) -> (Result);
  finish_recovery_migration : () -> (Result);
  // 口座snapshot（残高はvault、注文はcore。**封筒必須**）。
  get_account_snapshot : (HpkeRequest) -> (Result_1);
  // Agent世代の状態（承認済みは`current`、要求中は`next`）。
  // 
  // 認可にvaultへのinter-canister呼び出しが必要なためqueryにはできない（updateで提供）。
  get_agent_status : (SessionHandle) -> (Result_2);
  get_cycles_status : () -> (Result_3);
  // 現在の環境設定（診断用・公開）。秘密は含まない。
  get_environment : () -> (Result_4) query;
  // 現行のHPKE公開鍵。未生成はエラー（機密性の前提が欠けている）。
  get_hpke_public_key : () -> (Result_5) query;
  get_journal_guard : () -> (Result_6) query;
  get_journal_send_status : () -> (Result_7) query;
  get_market_status : (text) -> (Result_8) query;
  // 受付結果を再送せずに照合する。不存在と他人の要求は区別しない。
  get_order_by_request : (HpkeRequest) -> (Result_1);
  // 政策Canisterのprincipal（診断用）。
  get_policy_principal : () -> (opt principal) query;
  get_send_journal : () -> (Result_6) query;
  // vaultのprincipal（診断用）。
  get_vault_principal : () -> (opt principal) query;
  journal_restore_status : () -> (Result_9) query;
  // 約定一覧（新しい順。**封筒必須**。認可にvaultへの問い合わせが必要なためupdate）。
  list_fills : (HpkeRequest) -> (Result_1);
  // 注文一覧（新しい順。**封筒必須**）。
  // 
  // **updateである理由**：認可に `funds_vault` へのinter-canister呼び出しが必要だが、
  // queryでは他Canisterを呼べない。最終設計では、(a) 個人向け読み取りをupdateのまま
  // 提供する、(b) vaultからセッション写像をcoreへ同期してqueryで返す、のいずれかを選ぶ
  // （`docs/phase-1/README.md` の残課題）。
  list_orders : (HpkeRequest) -> (Result_1);
  mark_recovery_unknown : (RecoveryFenceToken) -> (Result);
  migrate_recovery : (PrepareRecovery) -> (Result_10);
  prepare_recovery : (PrepareRecovery) -> (Result_10);
  // 本人向け書込みの封筒入口。業務エラーも暗号化した結果として返す。
  private_call : (HpkeRequest) -> (Result_1);
  recovery_migration_locked : () -> (Result_11) query;
  recovery_replay_pending : () -> (Result_11) query;
  recovery_stage_status : () -> (Result_12) query;
  refresh_market : () -> (Result);
  // 外部確認済みのleverage preflight不明状態をcontrollerが解決する。
  resolve_unknown_order_preflight : (blob, PreflightResolution) -> (Result);
  resume_journal : () -> (Result);
  // HPKEの鍵世代を更新する（controllerのみ）。
  // 
  // 秘密鍵はcanister内のDBに留め、公開鍵のみを配布する（`Plan.md` 16.5、
  // `docs/phase-0/api-contract.md` 6節）。更新すると以前の世代は退役し、
  // 旧鍵で作られた封筒は復号できない（クライアントは公開鍵を取得し直す）。
  rotate_hpke_key : () -> (Result_5);
  // 閾値ECDSAのkey IDを設定する（controllerのみ）。
  // 
  // testnetの鍵名はデプロイ後に実測して確定する（`docs/phase-0/environments.md` 2節）。
  set_ecdsa_key_id : (text) -> (Result);
  set_journal_guard : (principal) -> (Result);
  // 銘柄解決に使うnetwork・dexを設定する（controllerのみ）。
  set_market_context : (text, text) -> (Result);
  // `meta`の`universe`を登録する（ローカルのブートストラップ。本番はHL `/info` から取得する）。
  set_meta_cache : (text, text, text) -> (Result);
  // 政策Canisterのprincipalを設定する（controllerのみ）。
  set_policy_principal : (principal) -> (Result);
  set_send_journal : (principal) -> (Result);
  // vaultのprincipalを設定する（controllerのみ）。
  set_vault_principal : (principal) -> (Result);
  // Hyperliquidのendpointを設定する（controllerのみ）。
  // 
  // 設定済みのnetworkと整合しないhost（例：testnet設定にmainnet endpoint）は拒否する。
  set_venue_endpoints : (text, text) -> (Result);
  // 未処理の注文・取消を送信し、取引所状態を照合する（controllerのみ）。
  // 
  // 本番は `heartbeat` が間隔を空けて呼ぶ。停止した場合の手動実行の入口でもある。
  sweep : () -> (Result_13);
  // 変換関数：`/info`の応答から照合に使う要素だけを決定論的に残す。
  // 
  // 全ノードで同じ本文にするため、付随フィールドと並びの揺れを落とす。解釈できない
  // 応答は空本文にし、呼び出し側は「未観測」として扱う（誤って建玉0にしない）。
  transform_info : (TransformArgs) -> (HttpRequestResult) query;
  transform_market_info : (TransformArgs) -> (HttpRequestResult) query;
  transform_open_orders : (TransformArgs) -> (HttpRequestResult) query;
  // このビルドのバージョン。デプロイ確認用。
  version : () -> (text) query;
  // セッションを検証し、本人のuser_idを返す（認可境界の試験用）。///
  // vaultに問い合わせ、返却されたprincipalが「このメッセージのcaller」と一致する場合だけ
  // user_idを返す。順序を逆にしない（callerを信用しない）。
  whoami : (SessionHandle) -> (Result_5);
}
